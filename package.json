{
  "name": "whatsapp-googlechat-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Customer relay between Google Chat spaces and WhatsApp (via Periskope).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "provision": "node provision.js",
    "sync": "node --env-file=.env sheet-sync.js",
