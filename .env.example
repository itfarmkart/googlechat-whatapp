# Copy to .env and fill in. The app reads plain process.env — load this with
# your platform's env injection, or `node --env-file=.env server.js` on Node 20+.

# --- Google -----------------------------------------------------------------
GOOGLE_KEY_FILE=./service-account.json
GOOGLE_PROJECT_NUMBER=123456789012
GOOGLE_IMPERSONATE_USER=ops@farmkart.com

# --- Periskope ------------------------------------------------------------
PERISKOPE_API_KEY=pk_live_xxx
PERISKOPE_PHONE=919876543210
PERISKOPE_SIGNING_KEY=whsec_xxx

# --- Workspace Events -> Pub/Sub (relays every space message, no @mention) ---
# Defaults derive from the service-account.json project. Override if needed.
# PUBSUB_TOPIC=projects/whatapp-506816/topics/chat-events
# PUBSUB_SUBSCRIPTION=chat-events-sub

# Sender names on the WhatsApp signature come from the People API directory
# (needs DWD scope directory.readonly, and the People API enabled). People not
# in the directory (myrsolar.com) go in sender-names.json. Override its path:
# SENDER_NAMES_FILE=./sender-names.json

# --- Auto-provision from the Leegality sheet (unset SHEET_ID to disable) ---
# SHEET_ID=18zOEIFjxu9pmR7tc_EPMOR-qovmVw3yVbSgUAK5H5QE
# SHEET_TAB=Leegality
# SHEET_FIRST_ROW=1071
# SHEET_HEADER_ROW=1
# SHEET_COL_NAME=Aadhaar Name English
# SHEET_COL_PHONE=Mobile No
# SHEET_COL_SALES=Assign to Site Visit
# SHEET_COL_STATUS=Agreement signed status (Leegality)
# SHEET_STATUS_DONE=COMPLETED
# SHEET_RUN_HOURS=0,12     # local-time hours to run at (default midnight & noon)
# SHEET_DRY_RUN=1          # log what would be provisioned, create nothing
# SHEET_MAX_PER_POLL=15    # cap spaces created per run

# --- Relay ----------------------------------------------------------------
PROVISION_TOKEN=change-me-to-a-long-random-string
PORT=8080
# STORE_FILE=./routes.json

# --- Local testing only — never set in production ------------------------
# SKIP_GCHAT_AUTH=1
# DISABLE_EVENTS=1   # don't open the Pub/Sub listener / Events subscription
